# Copy the CURRENT production cluster.env (including its unchanged secrets),
# then override only the release settings below. Do not use this file alone.
XXGATE_IMAGE_TAG=replace_with_loaded_unique_release_tag
XXGATE_HOST_PORT=8798
XXGATE_ENTRY_NODE_ID=entry-green
XXGATE_ENTRY_ALIAS=xxgate-green-entry
XXGATE_INGRESS_ALIAS=xxgate-green
# Logical IDs preserve accounts/bindings; physical aliases must be unique.
XXGATE_WORKER_A_NODE_ID=default
XXGATE_WORKER_B_NODE_ID=worker-b
XXGATE_WORKER_A_ALIAS=xxgate-green-worker-a
XXGATE_WORKER_B_ALIAS=xxgate-green-worker-b
XXGATE_WAIT_FOR_NODE_LOCK_SECS=3600
# On later releases choose unused aliases/project/entry ID or safely retire
# the earlier color first. Keep the stable xxgate alias on Nginx only.
